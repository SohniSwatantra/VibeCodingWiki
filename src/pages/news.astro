---
import AppLayout from '../layouts/AppLayout.astro';
import newsData from '../data/news.json';
import type { NewsItem } from '../types/news';

const news = (newsData as NewsItem[]).toSorted((a, b) => b.publishedAt.localeCompare(a.publishedAt));
const categories = [...new Set(news.map((item) => item.category))];
const lastVerified = news.reduce((latest, item) => item.verifiedAt > latest ? item.verifiedAt : latest, '');
---

<AppLayout title="VibeCoding News" description="Verified launches, acquisitions, tools, security updates, and community stories from the VibeCoding ecosystem.">
  <section class="rounded border border-[#a2a9b1] bg-[#f8f9fa] p-5 shadow-sm">
    <h2 class="text-[1.75rem] font-normal text-[#202122]">Latest coverage</h2>
    <p class="mt-2 text-sm text-[#54595d]">
      A source-linked record of notable product releases, acquisitions, launches, security developments, and community projects.
      Stories are checked daily; updates are published only when the evidence is specific and dated.
    </p>
    <p class="mt-2 text-xs text-[#72777d]">Last verified {new Date(`${lastVerified}T00:00:00Z`).toLocaleDateString('en-GB', { dateStyle: 'long', timeZone: 'UTC' })}</p>
    <ul class="mt-3 flex flex-wrap gap-2 text-xs text-[#202122]">
      {categories.map((category) => <li class="rounded border border-[#a2a9b1] bg-white px-2 py-1">{category}</li>)}
    </ul>
  </section>

  <section class="mt-6 space-y-4" aria-label="News stories">
    {news.map((item) => (
      <article class="rounded border border-[#c8ccd1] bg-white p-5 shadow-sm">
        <div class="flex flex-wrap items-center gap-2 text-xs text-[#72777d]">
          <span class="rounded border border-[#a2a9b1] bg-[#f8f9fa] px-2 py-1 text-[#202122]">{item.category}</span>
          <time datetime={item.publishedAt}>{new Date(`${item.publishedAt}T00:00:00Z`).toLocaleDateString('en-GB', { dateStyle: 'long', timeZone: 'UTC' })}</time>
        </div>
        <h2 class="mt-3 text-xl font-normal text-[#202122]">{item.title}</h2>
        <p class="mt-2 text-sm leading-6 text-[#54595d]">{item.summary}</p>
        <p class="mt-3 text-xs text-[#72777d]">
          Sources: {item.sources.map((source, index) => (
            <><a class="text-[#0645ad] hover:text-[#0b0080]" href={source.url} rel="noreferrer">{source.name}</a>{index < item.sources.length - 1 ? ', ' : ''}</>
          ))}
        </p>
      </article>
    ))}
  </section>
</AppLayout>
