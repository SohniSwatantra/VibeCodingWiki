---
import AppLayout from '../../layouts/AppLayout.astro';
import { runConvexQuery } from '../../lib/convex.server';

// Fetch all approved apps
const allApps = await runConvexQuery<any[]>('apps:listApps', { status: 'approved', limit: 200 }) || [];
const totalApps = allApps.length;
---

<AppLayout
  title="Vibecoded Apps"
  description="Explore apps built with AI-powered vibecoding tools"
>
  <div class="space-y-6">
    <article class="rounded border border-[#a2a9b1] bg-white p-6 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-semibold text-[#202122]">Vibecoded Apps Gallery</h2>
          <p class="text-sm text-[#54595d] mt-1">
            {totalApps} {totalApps === 1 ? 'app' : 'apps'} built using AI vibecoding tools
          </p>
        </div>
        <a
          href="/submit-app"
          class="inline-flex items-center rounded border border-[#0645ad] bg-[#0645ad] px-4 py-2 text-sm font-semibold text-white hover:bg-[#0b0080]"
        >
          Submit Your App
        </a>
      </div>

      {allApps.length === 0 ? (
        <div class="text-center py-8">
          <p class="text-[#54595d]">No apps have been submitted yet.</p>
          <a href="/submit-app" class="mt-4 inline-block text-[#0645ad] hover:underline">
            Be the first to submit an app!
          </a>
        </div>
      ) : (
        <div class="divide-y divide-[#eaecf0]">
          {allApps.map((app: any) => (
            <div class="py-4">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <h3 class="font-semibold text-[#202122]">{app.name}</h3>
                  <p class="mt-1 text-sm text-[#54595d]">{app.description}</p>
                  <div class="mt-2 flex flex-wrap gap-2">
                    <span class="rounded bg-[#e8f0ff] px-2 py-0.5 text-xs text-[#3366cc]">
                      {app.category === 'Others' ? app.categoryOther || 'Others' : app.category}
                    </span>
                    <span class="rounded bg-[#e6ffb3] px-2 py-0.5 text-xs text-[#4a7c00]">
                      Built with: {app.builtIn === 'Others' ? app.builtInOther || 'Others' : app.builtIn}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </article>

    <article class="rounded border border-[#a2a9b1] bg-white p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-[#202122] mb-4">About VibeCoding</h3>
      <p class="text-sm text-[#54595d] mb-4">
        VibeCoding is a new paradigm of software development where you describe what you want in natural language,
        and AI tools generate the code for you. These tools enable anyone to build applications without traditional coding skills.
      </p>
      <p class="text-sm text-[#54595d]">
        Have you built something amazing with a vibecoding tool? <a href="/submit-app" class="text-[#0645ad] hover:underline">Submit your app</a> to be featured in our gallery!
      </p>
    </article>

    <article class="rounded border border-[#a2a9b1] bg-[#f8f9fa] p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-[#202122] mb-4">For AI Tool Developers</h3>
      <p class="text-sm text-[#54595d] mb-4">
        Want to enable your users to submit apps directly from your AI coding tool?
        Use our <strong>Vibecodingwiki MCP</strong> (Model Context Protocol) server!
      </p>
      <p class="text-sm text-[#54595d]">
        Users can add the MCP to tools like Bolt, Lovable, Replit, and others to submit and browse apps without leaving their development environment.
      </p>
    </article>
  </div>
</AppLayout>
